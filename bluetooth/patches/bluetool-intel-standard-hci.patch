+            patched = true;
+        }
+        if (IntelStandardHCI::applyPowerQuery(data, size)) {
+            SYSLOG(MODULE_SHORT, "9462 24H32 LE TX power command-family selector applied");
+            patched = true;
+        }
+        if (IntelAudioClock::apply(data, size)) {
+            SYSLOG(MODULE_SHORT, "24H32 local audio clock connection lookup corrected");
+            patched = true;
+        }
+        if (IntelStandardHCI::applyEventMasks(data, size)) {
+            SYSLOG(MODULE_SHORT, "9462 24H32 LE startup event mask 0x21a5f applied");
+            patched = true;
+        }
+        if (IntelStandardHCI::applyEventMaskGetter(data, size)) {
+            SYSLOG(MODULE_SHORT, "9462 24H32 LE resume event mask 0x21a5f applied");
+            patched = true;
+        }
+        if (IntelStandardHCI::applyMultiAdvRandomAddress(data, size)) {
+            SYSLOG(MODULE_SHORT, "9462 24H32 multi-advertising random address support retained");
+            patched = true;
+        }
+        if (IntelStandardHCI::applyAdvSetRandomAddress(data, size)) {
+            SYSLOG(MODULE_SHORT, "9462 24H32 LE advertising set random address programming applied");
+            patched = true;
+        }
+        if (IntelStandardHCI::applyThirdPartyForce1M(data, size)) {
+            SYSLOG(MODULE_SHORT, "9462 24H32 third-party LE 1M default PHY applied");
+            patched = true;
+        }
+    }
+    if (searchAndPatch(data, size, path, kVendorCheckOriginal, kVendorCheckPatched))
+        patched = true;
+    if (searchAndPatch(data, size, path, kBadChipsetCheckOriginal, kBadChipsetCheckPatched))
+        patched = true;
+    if (getKernelVersion() >= KernelVersion::Ventura && getKernelVersion() < KernelVersion::Sequoia &&
+        searchAndPatch(data, size, path, kBadChipsetCheckOriginal13_3, kBadChipsetCheckPatched13_3))
+        patched = true;
+    if (getKernelVersion() >= KernelVersion::Sequoia &&
+        searchAndPatch(data, size, path, kBadChipsetCheckOriginal15_4, kBadChipsetCheckPatched15_4))
+        patched = true;
+    if (shouldPatchNvramCheck &&
