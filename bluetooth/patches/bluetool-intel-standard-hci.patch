+    if (shouldPatchAddress &&
+        searchAndPatchWithMask(data, size, path, kSkipAddressCheckOriginal, kSkipAddressCheckMask, kSkipAddressCheckPatched, kSkipAddressCheckMask))
+        patched = true;
+    return patched;
 }
 
