+static bool patchBluetoothdPage(uint8_t *data, size_t size, const char *path) {
+    bool patched = false;
+    if (getKernelVersion() == KernelVersion::Sequoia && getKernelMinorVersion() == 6) {
+        if (IntelStandardHCI::apply(data, size)) {
